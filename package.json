{
  "name": "echorating",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "db:push": "supabase db push",
    "db:push:local": "supabase db push --local",
    "db:reset": "supabase db reset --local --no-seed",
    "db:lint": "supabase db lint --local --fail-on error",
    "db:list": "supabase migration list",
    "audit:tenant-integrity": "node --experimental-strip-types --experimental-specifier-resolution=node scripts/audit-tenant-integrity.ts",
    "migrate:formulas:notion-v1": "node --experimental-strip-types --experimental-specifier-resolution=node scripts/migrate-formulas-to-notion-v1.ts",
    "backfill:calculated-metrics": "node --experimental-strip-types --experimental-specifier-resolution=node scripts/backfill-calculated-metrics.ts",
    "check:schema-drift": "node --experimental-strip-types --experimental-specifier-resolution=node scripts/check-schema-drift.ts",
    "typecheck": "tsc --noEmit",
    "test:unit": "node --experimental-strip-types --experimental-specifier-resolution=node --test tests/unit/*.test.ts",
    "test:e2e": "node --experimental-strip-types --experimental-specifier-resolution=node --test tests/e2e/*.test.ts"
  },
  "dependencies": {
    "@radix-ui/react-slot": "latest",
    "@sentry/nextjs": "^10.38.0",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.95.3",
    "class-variance-authority": "latest",
    "clsx": "latest",
    "dotenv": "^17.4.2",
    "lucide-react": "latest",
    "next": "latest",
    "react": "latest",
    "react-dom": "latest",
    "react-joyride": "^2.9.3",
    "resend": "^6.9.2",
    "svix": "^1.90.0",
    "swr": "^2.4.0",
    "tailwind-merge": "latest",
    "tw-animate-css": "latest",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "latest",
    "postcss": "^8",
    "shadcn": "latest",
    "tailwindcss": "^4",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5"
  }
}
